# Copy to .env.local. Use your own Supabase project or `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55431
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-or-local-anon-key
# Server-only. `mock` returns a fixed fictional transcript; real providers need the owner's approval.
TRANSCRIPTION_PROVIDER=mock
# Real speech-to-text: set TRANSCRIPTION_PROVIDER=openai and add a key from platform.openai.com.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# AI clinical notes (WS04). Server-only: never prefix these with NEXT_PUBLIC_.
# `mock` needs no account. `openai` uses OPENAI_API_KEY; `anthropic` uses ANTHROPIC_API_KEY.
# Switch only once the owner approves API spend.
NOTE_PROVIDER=mock
OPENAI_NOTE_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
